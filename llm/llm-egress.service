[Unit]
Description=LLM host egress block to the home network
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/llm/egress.nft
ExecReload=/usr/sbin/nft -f /etc/llm/egress.nft
ExecStop=/usr/sbin/nft delete table inet llm_egress

[Install]
WantedBy=sysinit.target
