[Unit]
Description=Local LLM API: vLLM behind an nginx allowlist (compose project llm)
Requires=docker.service
After=docker.service tailscaled.service llm-egress.service network-online.target
Wants=tailscaled.service network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/llm/llm.env
WorkingDirectory=/srv/llm
# the API is published on the Tailscale address only, which must exist before Docker can bind it
ExecStartPre=/bin/sh -c 'for i in $$(seq 90); do ip -4 -o addr show dev tailscale0 2>/dev/null | grep -qF " $$TS_IP/" && exit 0; sleep 2; done; echo "tailscale0 lacks $$TS_IP" >&2; exit 1'
ExecStart=/usr/bin/docker compose up --abort-on-container-exit --no-color --pull never
ExecStop=/usr/bin/docker compose down --timeout 30
Restart=on-failure
RestartSec=30
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
