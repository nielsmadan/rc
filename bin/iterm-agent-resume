#!/usr/bin/env python3
# Resume the agent saved in an iTerm2 arrangement, or clear this pane's binding.
# Usage: iterm-agent-resume --clear | --enable
# Saved launchers invoke --restore TOKEN. Restored login shells invoke --shell-startup.
# --clear forgets the pane's conversation and disables capture in this live pane until --enable.

import argparse
import base64
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "iterm2"))

import arrangement_agents as agents


def emit(name, value):
    encoded = base64.b64encode(value.encode()).decode()
    print(f"\033]1337;SetUserVar={name}={encoded}\007", end="", flush=True)


def main():
    parser = argparse.ArgumentParser(
        description="Manage automatic agent resume in this iTerm2 pane"
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--clear", action="store_true")
    group.add_argument("--enable", action="store_true")
    group.add_argument("--restore", metavar="TOKEN", help=argparse.SUPPRESS)
    group.add_argument("--shell-startup", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.clear or args.enable:
        if os.environ.get("TERM_PROGRAM") != "iTerm.app" or not sys.stdout.isatty():
            parser.error("run this command in an iTerm2 pane")
        emit("rcAgentDisabled", "1" if args.clear else "")
        print(
            "Agent restore disabled for this live pane; restored shells capture again."
            if args.clear
            else "Agent restore enabled for this pane."
        )
        return 0
    try:
        tty = os.ttyname(sys.stdin.fileno())
        home = Path.home()
        key = agents.signing_key(home / ".local/state/iterm-agent-resume")
        if args.restore is not None:
            agents.verify_record(agents.decode_record(args.restore), key)
        session_id = agents.pane_id(os.environ.get("ITERM_SESSION_ID"))
        from arrangement_iterm import prepare_resume

        import iterm2

        async def prepare(connection):
            try:
                return await prepare_resume(connection, session_id, tty, key), None
            except (TypeError, ValueError, iterm2.RPCException) as exc:
                return None, str(exc) or type(exc).__name__

        record, error = iterm2.Connection().run_until_complete(prepare, retry=False)
        if error:
            raise ValueError(error)
        if record is None:
            return 0
        return agents.run_agent(record, home, os.environ)
    except BlockingIOError:
        print(
            "Agent resume: this conversation is already being restored or running; opening a shell.",
            file=sys.stderr,
        )
        return 1
    except (
        ValueError,
        TypeError,
        OSError,
        RuntimeError,
        ImportError,
        subprocess.SubprocessError,
        KeyboardInterrupt,
    ) as exc:
        print(f"Agent resume: {exc or type(exc).__name__}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
