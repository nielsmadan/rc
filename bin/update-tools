#!/bin/bash
set -uo pipefail
trap 'exit 130' INT
trap 'exit 143' TERM

CHECK=0
BUMP_RUNTIMES=0
FAILURES=()

usage() {
  cat <<'EOF'
usage: update-tools [--check] [--bump-runtimes]

Update global tools managed by mise, Homebrew, uv, and pipx, plus
agent-browser's Chrome download. Missing package managers are skipped.

  --check          preview commands without running updates
  --bump-runtimes  also advance mise language runtime pins to latest releases
  -h, --help       show this help

CLI version pins are advanced and saved by mise. Runtime versions/ranges
are respected unless --bump-runtimes is given. Vault's pin is always kept.
Homebrew updates include GUI apps with their own updaters.
macOS, App Store apps, project dependencies, and git checkouts are excluded.
Failures are collected; other updates continue. Exit 1 if any step fails.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --check) CHECK=1 ;;
    --bump-runtimes) BUMP_RUNTIMES=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

cd "$HOME" || exit 1

run() {
  printf '\n+'
  printf ' %q' "$@"
  printf '\n'
  [ "$CHECK" = 1 ] && return 0
  local status
  if "$@"; then
    return 0
  else
    status=$?
    case "$status" in 130|143) exit "$status" ;; esac
    printf 'FAILED (%s): %s\n' "$status" "$*" >&2
    FAILURES+=("$*")
    return "$status"
  fi
}

HAS_BROWSER=0
HAS_PIPX=0

if command -v mise >/dev/null 2>&1; then
  run mise self-update --yes
  CLI_TOOLS=()
  RUNTIME_TOOLS=()
  PINNED_TOOLS=()

  if tool_names=$(mise ls --current --json | python3 -c 'import json, sys; print("\n".join(json.load(sys.stdin)))'); then
    while IFS= read -r tool; do
      case "$tool" in
        '') continue ;;
        node|ruby|python|rust|java|bun|deno|go|elixir|erlang|dotnet|php|swift|zig)
          RUNTIME_TOOLS+=("$tool") ;;
        aqua:hashicorp/vault|vault)
          PINNED_TOOLS+=("$tool") ;;
        *) CLI_TOOLS+=("$tool") ;;
      esac
      [ "$tool" = npm:agent-browser ] && HAS_BROWSER=1
      [ "$tool" = pipx ] && HAS_PIPX=1
    done <<< "$tool_names"

    if [ "${#CLI_TOOLS[@]}" -gt 0 ]; then
      run mise upgrade --yes --bump "${CLI_TOOLS[@]}"
    fi
    if [ "${#RUNTIME_TOOLS[@]}" -gt 0 ]; then
      if [ "$BUMP_RUNTIMES" = 1 ]; then
        run mise upgrade --yes --bump "${RUNTIME_TOOLS[@]}"
      else
        run mise upgrade --yes "${RUNTIME_TOOLS[@]}"
      fi
    fi
    if [ "${#PINNED_TOOLS[@]}" -gt 0 ]; then
      printf '\nKeeping Vault within its configured version; latest-tag resolution is unreliable.\n'
      run mise upgrade --yes "${PINNED_TOOLS[@]}"
    fi
  else
    printf 'FAILED: could not read global mise tools\n' >&2
    FAILURES+=("read global mise tools")
  fi
else
  printf 'skip mise (not installed)\n'
fi

if command -v brew >/dev/null 2>&1; then
  if run brew update; then
    run brew upgrade --formula
    run brew upgrade --cask --greedy
  fi
else
  printf 'skip Homebrew (not installed)\n'
fi

if command -v uv >/dev/null 2>&1; then
  run uv self update
  run uv tool upgrade --all
else
  printf 'skip uv (not installed)\n'
fi

if [ "$HAS_PIPX" = 1 ]; then
  run mise exec -- pipx upgrade-all
elif command -v pipx >/dev/null 2>&1; then
  run pipx upgrade-all
else
  printf 'skip pipx (not installed)\n'
fi

if [ "$HAS_BROWSER" = 1 ]; then
  run mise exec -- agent-browser install
elif command -v agent-browser >/dev/null 2>&1; then
  run agent-browser install
else
  printf 'skip agent-browser Chrome (not installed)\n'
fi

if [ "${#FAILURES[@]}" -gt 0 ]; then
  printf '\nFailed steps:\n' >&2
  printf '  %s\n' "${FAILURES[@]}" >&2
  exit 1
fi

if [ "$CHECK" = 1 ]; then
  printf '\nPreview complete; no updates were run.\n'
else
  printf '\nUpdates complete. Open a new terminal to refresh tool paths.\n'
fi
